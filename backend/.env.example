# --- LLM provider: set ONE key. With no key, DevDocs AI runs in offline mode
# (retrieval only: it shows the most relevant code instead of writing an explanation).
GOOGLE_API_KEY=
OPENAI_API_KEY=
# LLM_PROVIDER=gemini            # gemini | openai | offline  (auto-detected from keys)
# GEMINI_MODEL=gemini-2.5-flash
# OPENAI_MODEL=gpt-4o-mini

# --- Embeddings: sentence-transformers if installed, otherwise a built-in hashing embedder
# EMBEDDING_BACKEND=auto         # auto | sentence-transformers | hash
# EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- Optional
# GITHUB_TOKEN=                  # lets you index private repos
# TOP_K=8
# CORS_ORIGINS=http://localhost:5173
